# LOCK-FIX test environment template.
# Copy to a local-only env file when needed. Do not commit real credentials.

LOCKFIX_ENV=test
LOCKFIX_WEB_HOST=127.0.0.1
LOCKFIX_WEB_PORT=8088
LOCKFIX_CONFIG_PATH=config/lockfix.example.json

# Veeam REST API test placeholders.
LOCKFIX_VEEAM_BASE_URL=https://127.0.0.1:9419
LOCKFIX_VEEAM_EM_BASE_URL=https://127.0.0.1:9398
LOCKFIX_VEEAM_API_VERSION=1.2-rev1
LOCKFIX_VEEAM_USER=
LOCKFIX_VEEAM_PASSWORD=
LOCKFIX_VEEAM_JOB_NAME=
LOCKFIX_VEEAM_JOB_ID=

# Test execution defaults.
LOCKFIX_TEST_DRY_RUN=true
LOCKFIX_TEST_AUDIT_RETENTION_DAYS=30
LOCKFIX_TEST_APPROVAL_REQUEST_TYPE=DISK_ONLINE
