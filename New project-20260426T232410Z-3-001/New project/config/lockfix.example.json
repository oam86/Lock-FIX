{
  "dry_run": true,
  "state_path": "runtime/state.json",
  "audit_log_path": "runtime/audit.jsonl",
  "io_quiet_seconds": 30,
  "disk_wait_seconds": 60,
  "veeam": {
    "enabled": true,
    "host": "192.168.219.230",
    "port": 9419,
    "api_version": "1.2-rev1",
    "verify_tls": false,
    "username_env": "LOCKFIX_VEEAM_USERNAME",
    "password_env": "LOCKFIX_VEEAM_PASSWORD",
    "timeout_seconds": 5
  },
  "slots": [
    {
      "slot_id": "BAY-01",
      "device": "/dev/disk/by-id/ata-LOCKFIX_TEST_DISK",
      "mount_point": "/mnt/lockfix/BAY-01",
      "expected_uid": "replace-with-registered-uid",
      "identity": {
        "serial": "TEST-SERIAL-001",
        "model": "TEST-HDD",
        "wwn": "TEST-WWN-001"
      },
      "manifest_path": ".lockfix_manifest.sha256",
      "power": {
        "type": "mock",
        "off_command": [
          "usbrelay",
          "BAY_01=0"
        ],
        "on_command": [
          "usbrelay",
          "BAY_01=1"
        ]
      }
    }
  ]
}
